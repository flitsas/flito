// Especificación común de la arquitectura de FLIT. Esta es la FUENTE: flitsas/flito lleva una copia idéntica en
// docs/arquitectura/specification.c4 y su workflow arquitectura.yml falla si las dos se separan.
// Los repos son públicos: nada de IP, secretos, hosts internos ni datos personales en los modelos.
// textSize xl y size sm: en el marco de Atlas (928 px) el texto se lee sin zoom.
specification {
  // ── Elementos ─────────────────────────────────────────────
  element actor {
    style {
      size sm
      textSize xl
      shape person
      color secondary
    }
  }
  element system {
    style {
      size sm
      textSize xl
      color primary
    }
  }
  element external {
    notation 'Sistema externo'
    style {
      size sm
      textSize xl
      color muted
    }
  }
  element webapp {
    notation 'Aplicación web'
    style {
      size sm
      textSize xl
      shape browser
    }
  }
  element service {
    notation 'Servicio / API'
    style {
      size sm
      textSize xl
    }
  }
  element database {
    style {
      size sm
      textSize xl
      shape storage
    }
  }
  element queue {
    style {
      size sm
      textSize xl
      shape queue
    }
  }
  element bucket {
    style {
      size sm
      textSize xl
      shape storage
      color muted
    }
  }
  element component {
    style {
      size sm
      textSize xl
    }
  }
  // Agrupa elementos para que los resúmenes se lean; no es un sistema ni se despliega.
  element grupo {
    style {
      size sm
      textSize xl
      color slate
    }
  }

  // ── Relaciones ───────────────────────────────────────────
  relationship sync {
    line solid
  }
  relationship async {
    line dashed
    color amber
  }
  relationship grpc {
    line solid
    color indigo
  }

  // ── Tags (plan 01 §8.3) ──────────────────────────────────
  tag pii              // toca datos personales (Ley 1581)
  tag critico          // su caída detiene la operación de clientes
  tag legado           // FLIT 1 o código a retirar
  tag objetivo         // diseñado y aprobado, aún no en producción
  tag vigente          // camino actual que será reemplazado
  tag temporal         // existe por una migración
  tag ia               // usa un LLM
  tag externo_publico  // expuesto a terceros fuera de FLIT
  tag suite            // parte de la FLIT Suite (OIDC común)
  tag referencia       // elemento de otro repo, redeclarado solo para poder relacionarlo aquí
}
