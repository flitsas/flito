// Vistas estáticas de FLITO (plan 01 §5 de Atlas). Las de componentes y las dinámicas están en sus carpetas.
// Las vistas de despliegue no se escriben a mano: las emitirá el generador desde gitops y nunca viven en este repo.
views {
  // V03
  view flito_contexto of flito {
    title 'FLITO: contexto'
    description 'El sistema con sus actores y los sistemas con los que habla.'
    include
      flito,
      operador_flito, organismo, cea,
      flit1, flit2,
      runt, simit, verifik, kyverum, fasecolda, mercadolibre, siigo, rndc, uiaf, listas_restrictivas,
      supertransporte, google_drive, whatsapp, zapsign, llm, ado, correo
  }

  // V05
  view flito_contenedores of flito {
    title 'FLITO: contenedores'
    description 'Web, API y almacenes, con sus relaciones hacia afuera.'
    include *
  }
}
