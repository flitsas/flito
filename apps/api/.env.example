# Plantilla de variables de entorno — operaciones-system API.
# Copiar a `.env` y completar valores. NUNCA commitear `.env`.

# Entorno
NODE_ENV=development
PORT=3005

# Base de datos PostgreSQL (operaciones_db). Usuario operaciones_app, NO postgres (WORM rndc).
DATABASE_URL=postgresql://operaciones_app:CAMBIAR_PASSWORD@localhost:5432/operaciones_db

# JWT (mín 32 caracteres). Generar con: `openssl rand -hex 48`.
JWT_SECRET=GENERAR_NUEVO_AL_DEPLOYAR_MIN_32_CHARS

# Clave HMAC dedicada para tokens de descarga pública (drive procesador).
# Si no se define, se usa JWT_SECRET (compatible con tokens distribuidos).
# Recomendado: definir clave independiente para que rotar JWT no rompa Excels distribuidos.
# Generar con: `openssl rand -hex 32`.
DOWNLOAD_TOKEN_SECRET=

# Token del scrape de GET /metrics (mín 32 chars). Generar con: `openssl rand -hex 32`.
# En blanco = la ruta responde 404 (defecto seguro): el registro Prometheus estuvo público
# en DEV, QA y PDN porque su única defensa era una suposición sobre nginx (Bug #11599).
# Para exponerla a un scraper: definir esta variable y configurar `bearer_token` en el job.
METRICS_TOKEN=

# CORS. Dev local: '*'. Producción: lista comma-separated de URLs https.
# El boot falla si NODE_ENV=production y CORS_ORIGIN incluye '*'.
CORS_ORIGIN=http://localhost:5173

# Anthropic (opcional para módulos OCR/IA). Compartida con CEA / Catastro.
ANTHROPIC_API_KEY=sk-ant-...
# FLOTA-03: modelos OCR configurables (con default). Cambiar SIN redeploy si
# Anthropic deprecate un snapshot (causa raíz INC-OCR-2026-05-12). En blanco = default.
ANTHROPIC_MODEL_HAIKU=
ANTHROPIC_MODEL_SONNET=

# RUNT consultas (mín 20 chars). Llave `kr_live_…` de la pasarela runt.kyverum.com; viaja como
# `Authorization: Bearer`. Sustituye al proxy CEA, que ya no existe.
RUNT_INTERNAL_KEY=GENERAR_AL_DEPLOYAR_MIN_20_CHARS

# Cifrado PII general (mín 32 chars). Generar con: `openssl rand -hex 32`.
PII_ENC_KEY=GENERAR_AL_DEPLOYAR_MIN_32_CHARS

# HMAC determinístico para búsqueda de cédula (64 hex = 32 bytes). OBLIGATORIO:
# el boot falla si falta. Separado de PII_ENC_KEY por mínimo privilegio (ISO A.9.4).
# Generar con: `openssl rand -hex 32`.
PII_HMAC_KEY=GENERAR_AL_DEPLOYAR_64_HEX_CHARS

# RNDC (Sprint 4 Fase 4.2): clave AES-256-GCM (64 hex = 32 bytes).
# Generar con: `openssl rand -hex 32`. En dev se deriva de PII_ENC_KEY si falta.
RNDC_ENC_KEY=
RNDC_MODE=mock
RNDC_MOCK_ERROR_RATE=0
RNDC_MOCK_TIMEOUT_RATE=0.02
# OPS-08: NIT empresa emisora RNDC (6-12 dígitos). Default 900000001.
EMPRESA_NIT=900000001
# OPS-08: ambiente del envío SOAP RNDC. sandbox | produccion. Default sandbox.
RNDC_AMBIENTE=sandbox

# --- Siigo API (Feature #11239): facturación electrónica de trámites ---
# Clave AES-256-GCM propia para el access_key de la credencial. Generar con: `openssl rand -hex 32`.
# A DIFERENCIA de RNDC_ENC_KEY, NO se deriva de otra clave si falta: sin ella la administración
# de credenciales de Siigo responde 503 y la integración no opera (HU #11247).
SIIGO_ENC_KEY=
# URL base de Siigo API y ambiente contra el que se opera.
SIIGO_BASE_URL=https://api.siigo.com
SIIGO_AMBIENTE=pruebas
# Nombre de la aplicación integradora: 3-100 alfanuméricos, SIN espacios ni caracteres especiales.
# Siigo monitorea este valor y bloquea a quien envíe información falsa. Debe ser el mismo para
# todas las empresas de la integración.
SIIGO_PARTNER_ID=
# Modo de la integración. `mock` no toca la red: es el valor seguro mientras no haya credenciales
# del ambiente real. Pasar a `real` es una decisión explícita de despliegue (HU #11252).
SIIGO_MODE=mock
# Interruptor ÚNICO de los tres crons de Siigo: archivo de soportes, sondeo del estado ante la DIAN
# y vaciado de la cola de emisión. `on` | `off`, y NADA más: cualquier otro valor no arranca.
# APAGADO por defecto (Bug #11649): emitir ante la DIAN es irreversible, así que encenderlo tiene
# que ser un acto deliberado del despliegue y no el efecto de que falte una variable. No arrancar
# se nota —la cola crece y se ve—; arrancar de más no se nota hasta que el documento ya salió.
# DEV, QA y PDN necesitan SIIGO_CRONS=on explícito o los tres quedan apagados.
SIIGO_CRONS=off

# SMTP (notificaciones operativas). Office 365 o equivalente.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@kyverum.com
SMTP_PASS=
SMTP_FROM_NAME=FLIT Operaciones

# URLs públicas
PUBLIC_URL=http://localhost:5173

# MinIO / S3 (almacenamiento de evidencias)
S3_ENDPOINT=s3.kyverum.com
S3_PORT=443
S3_ACCESS_KEY=GENERAR_USUARIO_MINIO
S3_SECRET_KEY=GENERAR_PASS_MINIO

# Google Drive (cuenta de servicio JSON + ID carpeta raíz compartida con esa cuenta)
#
# En DESPLIEGUE CON DOCKER no se pone aquí: el compose de producción monta el fichero del host en
# /run/secrets/service-account.json y fija GOOGLE_DRIVE_KEY_PATH a esa ruta. Poner aquí la ruta del
# host hace que la API falle con «Archivo de clave no encontrado», porque el contenedor no ve el
# sistema de ficheros del VPS. Si el fichero está en otro sitio del host, se indica con
# GOOGLE_DRIVE_KEY_HOST_PATH.
#
# En LOCAL sin Docker sí es la ruta real del disco. Ejemplo: /home/tu-usuario/service-account.json
GOOGLE_DRIVE_KEY_PATH=
GOOGLE_DRIVE_FOLDER_ID=

# Barrido diario del Drive de derechos de tránsito. SOLO PRODUCCIÓN: sin esta variable en '1' el
# cron no arranca, y en local no debe arrancar porque cada página procesada es una llamada de OCR
# de pago. La puerta es positiva a propósito: no se deduce del entorno.
#
# El PRIMER barrido no procesa nada: marca como vistos los consolidados que ya estaban en la carpeta
# y sale. El histórico se procesa a mano desde la pestaña, archivo por archivo, si interesa.
DRIVE_DERECHOS_CRON_ENABLED=
# Hora local de Colombia del barrido. Por defecto 9. Solo se mueve para probar.
DRIVE_DERECHOS_CRON_HORA=

# Redis (lockout login distribuido + rate limiting + JWT blacklist).
# Si no se define, default redis://127.0.0.1:6379. EN PRODUCCIÓN ES OBLIGATORIO Redis activo.
REDIS_URL=redis://127.0.0.1:6379

# Destinatarios alertas PESV (alcoholimetría positiva, etc.). Coma-separados.
# Vacío → fallback a admins activos del tenant. NUNCA dejar emails @kyverum.com aquí.
PESV_ALERT_RECIPIENTS=

# Destinatarios alertas SLA LAFT/ROS (warn_12h, warn_4h, breach). Coma-separados.
# Vacío (opt-in deliberado) → el cron registra la alarma sin destinatarios, no falla.
LAFT_COMPLIANCE_RECIPIENTS=

# --- TRAM-INNOV (opcionales; con default en env.ts — sync OPS-06 PREP) ---
# Notificaciones de estado por WhatsApp (Meta Cloud API). Sin ambas → canal off
# (degradación a email/enlace manual). NO commitear valores reales.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Bloquear "Enviar a tránsito" si faltan obligatorios del checklist. Default true.
# (en blanco = true; poner 'false' para desactivar)
TRAMITE_STRICT_CHECKLIST=
# Si el email de validación de identidad falla, devolver enlace manual en vez de
# bloquear. Default true. (en blanco = true; 'false' para desactivar)
TRAMITES_EMAIL_FALLBACK=
# TRAM-COMMS-02: cron de recordatorios a participantes del portal (09:00 UTC).
# Default OFF. Poner '1' SOLO en prod cuando SMTP (y/o WhatsApp) esté configurado.
TRAM_PORTAL_REMINDER_CRON_ENABLED=
# OPS-08: cron de retención/anonimización PII (Ley 1581 / ISO A.8.10). Default OFF.
# Poner '1' SOLO tras validar P0-NEG-3/4 estables 48h en prod.
PRIVACY_RETENTION_CRON_ENABLED=
# TRAM-INNOV-B3: firma electrónica de compraventa. mock (default) | zapsign.
FIRMA_PROVIDER=mock
# Secreto HMAC para validar webhooks de firma (requerido en prod con zapsign).
FIRMA_WEBHOOK_SECRET=
# Token API ZapSign (solo si FIRMA_PROVIDER=zapsign). Sandbox por defecto.
ZAPSIGN_API_TOKEN=
ZAPSIGN_SANDBOX=true

# --- FLITO (migración packages/ → Operaciones: SOAT e Impuestos) ---
# Origen de trámites: integración HTTP real contra el reporte de FLIT 1.0 (solo lectura).
# Base configurable (default = el del doc de integración).
FLIT_BASE_URL=https://1qmxln7fa7.execute-api.us-east-1.amazonaws.com/pdn
# Umbral de confianza OCR por defecto (0..1). Bajo el umbral → cola de revisión.
OCR_UMBRAL_DEFECTO=0.85
# Cron de sincronización desde FLIT (6 campos con segundos). Default: cada 5 min.
SYNC_CRON=0 */5 * * * *
# Habilita el job de sincronización FLITO. Default true (en blanco = true; 'false'/'0' apaga).
SYNC_HABILITADO=

# --- Monitoreo de comparendos (Feature #11492, 17a) ---
# Hosts de las dos fuentes. SIEMPRE por env, nunca en el código: cada ambiente apunta a uno
# distinto y los proveedores cambian de dominio. Sin valor por defecto a propósito. Las dos deben
# ser `https://` y solo el origen: el adapter rechaza otro esquema, o una base con query/fragmento,
# con 503 `fuente_no_configurada`.
VERIFIK_SIMIT_BASE_URL=
# Solo el ORIGEN (`http://host` o `https://host`): la ruta `/infraction/api/Infraccion/…` la pone
# el adapter. Admite puerto (`…:8080`) desde el 2026-08-20; el proveedor actual no lo necesita.
# OJO: esta es la ÚNICA fuente del monorepo que acepta `http://`, porque el proveedor no publica
# HTTPS (decisión de David, 2026-08-20). Con una base `http://` el NIT monitoreado viaja SIN
# CIFRAR hasta el proveedor y el adapter deja un `log.warn` la primera vez que usa esa base en un
# proceso (no una vez por corrida: el reinicio del aviso aún no lo llama nadie); registrado en
# docs/privacy/registro-terceros-destinatarios.md. Verifik sigue siendo https-only (lleva Bearer).
UTS_MUNICIPAL_BASE_URL=
# Clave AES-256-GCM propia del token SIMIT (ADR-0002). Generar con: `openssl rand -hex 32`.
# Dedicada, NO derivada de SIIGO_ENC_KEY ni RNDC_ENC_KEY: si una se compromete, las demás
# integraciones siguen protegidas. Sin ella, configurar o usar el token falla explícito.
COMPARENDOS_ENC_KEY=
# Bootstrap SOLO de desarrollo del token SIMIT (HU #11498). Se usa únicamente si NO hay fila
# activa en `flito_comparendos_token_simit`; nunca se loguea ni se devuelve por el API. En PDN
# el token va cifrado en BD vía PUT /api/flito/comparendos/config/token-simit: un token en env
# no deja trazabilidad de quién lo puso ni cuándo, que es lo que exige CF-03. Dejar en blanco.
VERIFIK_SIMIT_TOKEN=
# Modo de los adapters Verifik/UTS. `mock` no toca la red: valor seguro mientras no haya
# credenciales reales. Pasar a `real` es decisión explícita de despliegue.
COMPARENDOS_SIMIT_MODE=mock
# Retención del histórico de registros y timeline, en meses (Ley 1581). Decisión humana: 24.
# La consume el cron de purga (HU #11511): borra los comparendos que nadie ha vuelto a ver desde
# el corte y las corridas de sync anteriores a él (timeline y pasos caen por CASCADE).
COMPARENDOS_RETENTION_MONTHS=24
# Puerta del cron de purga: solo el valor '1' lo enciende. Un job que BORRA no debe arrancar por el
# hecho de desplegarse. Correr antes, contra la base del ambiente:
#   npm run comparendos:purga:dry -w apps/api
# para saber cuánto se llevaría la primera pasada (cuenta TODOS los candidatos, no un lote) y si
# alguno de los dos frenos de RN-30 saltaría. El script SOLO hace pasadas en seco: no acepta ningún
# flag que borre.
COMPARENDOS_PURGA_CRON_ENABLED=0
# Freno de la purga (RN-30). El troceado en lotes limita el RITMO del borrado, no el daño: una purga
# equivocada vacía la tabla igual, a 10 000 filas por día. Una pasada se aborta ENTERA si los
# candidatos superan este porcentaje de la tabla, o si no hay ninguna corrida de sync `completed` /
# `partial` en los últimos N días — `ultimo_visto_en` solo avanza cuando el sync corre, así que con
# el sync parado la tabla envejece entera y la purga borraría datos VIGENTES sin que nadie lo note.
# Para la primera pasada de una base con años de histórico: mirar la pasada en seco
# (`npm run comparendos:purga:dry -w apps/api`) y subir el ratio a conciencia, una vez.
COMPARENDOS_PURGA_MAX_RATIO=0.25
COMPARENDOS_PURGA_SYNC_MAX_DIAS=7
# Timeout por llamada al proveedor (ms) y municipales en paralelo por NIT (ADR-0001 §7).
# El sync es síncrono y el nginx del web corta a los ~120 s: la matriz NIT × municipios en
# serie con los 15 s por defecto del cliente HTTP se pasa de largo.
COMPARENDOS_HTTP_TIMEOUT_MS=8000
COMPARENDOS_SYNC_CONCURRENCIA=5
# Freno de inactivación masiva (RN-24): tope de filas y de porcentaje de activos que una sola
# corrida puede apagar. Si el barrido lo superara, no se apaga NADA y la corrida se cierra como
# `partial`. Cubre al proveedor que responde 200 con lista vacía (token vencido, cambio de
# contrato): apagar el histórico es reversible en los registros, pero no en el timeline.
COMPARENDOS_INACTIVACION_MAX_FILAS=200
COMPARENDOS_INACTIVACION_MAX_RATIO=0.5
# Tope de filas de un export a Excel del consolidado (HU #11558, ADR-0004). Un filtro que devuelva
# más responde 422 `export_demasiado_grande` y no genera archivo. No es un ajuste de rendimiento:
# multiplicado por su limitador (5 exports por minuto y usuario) es el techo de extracción de datos
# personales del módulo, así que BAJARLO es seguro y subirlo es una decisión de privacidad. Por
# encima de 20 000 el boot falla a propósito: a esa escala toca ADR sucesor (export asíncrono).
#
# 2 000 y no 5 000 desde la HU #11651, y el motivo es MEMORIA, no privacidad: `sendExcel` construye
# el workbook entero en el proceso y el API corre en una sola instancia fork con
# `max_memory_restart: '512M'`. Medido, dos exports simultáneos de 5 000 filas en el peor caso
# añadían 247 MB de RSS —de los ~262 MB que hay entre un API en régimen y el techo de PM2— y dejaban
# el proceso a 15 MB del reinicio; con 2 000 son 106 MB. El limitador es por usuario y no hay cota
# global, así que dos administradores a la vez es un escenario normal, no un pico raro.
#
# OJO AL DESPLEGAR: si un `.env` ya existente trae el 5 000 de la versión anterior de este archivo,
# el valor del entorno GANA sobre el nuevo defecto de `shared-types` y el ajuste no surte efecto.
# Hay que bajarlo a mano en cada ambiente, o borrar la línea para heredar el defecto.
COMPARENDOS_EXPORT_MAX_FILAS=2000

# ── FLITO Conciliación de boletas (Feature #11623, HU #11676) ──────────────────
# Tope de líneas de una boleta del portal. Por encima, la carga responde 400
# `demasiadas_filas` con este número dentro y no crea ni boleta ni líneas.
# El coste real no es leer el Excel: es que conciliar asienta UNA salida de bolsa por línea, en
# serie y dentro de una sola transacción, porque el saldo se encadena. Por encima de 2 000 el boot
# falla a propósito — a esa escala hace falta otro diseño (lote asíncrono), no otra variable.
# El valor por defecto es CONCILIACION_MAX_FILAS de shared-types, que es el número que la pantalla
# de carga anuncia antes de subir el archivo: si se cambia aquí, los dos dejan de coincidir y quien
# manda es el error del API, que trae su propio `maximo`.
CONCILIACION_MAX_FILAS=500
