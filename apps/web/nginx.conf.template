# Plantilla nginx — renderizada por envsubst en el arranque del contenedor
# (entrypoint oficial de nginx: templates/*.template → conf.d/*.conf).
# Variables sustituidas: ${NGINX_PORT}, ${API_HOST}, ${API_PORT}.
# Las variables propias de nginx ($host, $uri, ...) NO se tocan porque envsubst
# solo reemplaza variables de entorno definidas.

server {
    listen ${NGINX_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    # Ojo: `gzip_types` toma MIME TYPES, no extensiones — poner `mjs` aquí no haría nada.
    # `text/javascript` es el tipo con el que el bloque `types` de /assets/ sirve el worker de
    # pdf.js (`pdf.worker.min-<hash>.mjs`, HU #11289): sin él ese fichero viajaría sin comprimir.
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API → contenedor api (misma red de compose). Sin URI en proxy_pass para
    # que el path original /api/... llegue intacto al backend Express.
    location /api/ {
        # Lotes de PDFs (SOAT/impuestos: multer acepta hasta 50 archivos x 15MB).
        # 250m alinea con el client_max_body_size del reverse-proxy del HOST y con
        # CARGA_MASIVA_MAX_BYTES_CUERPO (packages/shared-types). 100m se quedaba corto:
        # una tanda real de 35 comprobantes pesaba 228 MB y nginx la cortaba con 413
        # antes de que la API la viera (produccion, 2026-09-02).
        client_max_body_size 250m;
        proxy_pass http://${API_HOST}:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # IP real del cliente (Bug #12953 — «bloqueo general por intentos de ingreso»).
        # Hay dos saltos: proxy del HOST (TLS, pone X-Forwarded-For) → este nginx → api, y la
        # api confía en UN salto (`trust proxy = 1` en apps/api/src/app.ts). Con el
        # `$proxy_add_x_forwarded_for` de antes, el último elemento del XFF —el que la api toma
        # como `req.ip`— era la IP del gateway Docker, la MISMA para todos: el `authLimiter` se
        # volvía un cupo global y el que agotaba sus intentos dejaba fuera a todo el mundo.
        #
        # realip reescribe `$remote_addr` con la IP del cliente: toma el XFF y descarta desde la
        # derecha las direcciones de confianza (redes privadas/Docker); con `real_ip_recursive on`
        # se queda con la primera NO confiable, la que anotó el proxy del host. Un XFF falso que
        # mande el propio navegador queda a su izquierda y no la suplanta.
        #
        # A la api se le manda SOLO esa IP (sin concatenar el XFF entrante), así su único salto
        # de confianza la lee tal cual. `trust proxy` NO se sube a 2: el dominio api.* llega
        # directo del proxy del host (un salto) y ahí abriría la suplantación.
        #
        # Todo depende de que el proxy del host ESCRIBA el XFF (lo añada o lo reescriba con la IP
        # de quien le conecta). Si no lo manda, `$remote_addr` sigue siendo el gateway y el cupo
        # vuelve a ser global, como antes. Si lo reenviara tal cual llega del navegador, la IP
        # sería suplantable (solo se esquiva el límite por IP; el bloqueo por usuario sigue).
        # Verificarlo en cada ambiente: un `X-Forwarded-For: 1.2.3.4` falso no debe esquivar el 429.
        set_real_ip_from 127.0.0.1;
        set_real_ip_from ::1;
        set_real_ip_from 10.0.0.0/8;
        set_real_ip_from 172.16.0.0/12;
        set_real_ip_from 192.168.0.0/16;
        set_real_ip_from fc00::/7;
        real_ip_header X-Forwarded-For;
        real_ip_recursive on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # La carga masiva de SOAT/impuestos procesa el OCR en serie (~3,4 s por comprobante),
        # asi que una tanda llena supera los tres minutos. Este corte tiene que quedar POR
        # ENCIMA de TIMEOUT_MAX_MS de apps/web/src/lib/api.ts (600 s): si nginx corta primero,
        # el cliente recibe 504 en vez de su propio abort y pierde la distincion entre «se me
        # acabo el tiempo» y «el servidor fallo».
        proxy_read_timeout 900s;
    }

    # Assets con hash de Vite → cache inmutable (se re-descargan solo si cambia el hash).
    location /assets/ {
        # MIME de `.mjs` (HU #11289). `mime.types` de nginx:1.27-alpine NO trae `mjs` (verificado:
        # `grep -c mjs /etc/nginx/mime.types` → 0), así que el worker de pdf.js v6
        # —`/assets/pdf.worker.min-<hash>.mjs`— saldría como `application/octet-stream`. pdf.js v6 lo
        # instancia como MÓDULO (`new Worker(src, { type: "module" })`) y ahí el navegador aplica
        # MIME checking estricto: con octet-stream el worker queda BLOQUEADO y los cinco visores
        # mueren en «No se pudo abrir el documento». La E2E no lo vería —corre contra el dev server
        # de Vite, que sirve el MIME correcto—, así que este fallo llegaría a producción con el CI
        # entero en verde.
        #
        # El `include` NO es decorativo: `types` NO se fusiona con el nivel superior, lo REEMPLAZA
        # («inherited from the previous level if and only if there are no types directives defined on
        # the current level»). Medido sobre nginx:1.27-alpine: con sólo `types { text/javascript mjs; }`
        # aquí dentro, nginx arranca sin quejarse y pasa a servir `app.js` y `s.css` de /assets/ como
        # `application/octet-stream` — es decir, tumba el bundle y los estilos de TODA la aplicación
        # para arreglar el worker. Dos bloques `types` en el mismo nivel sí acumulan, y por eso la
        # forma correcta es reponer la tabla por defecto con el `include` y añadir sólo lo que falta.
        include /etc/nginx/mime.types;
        types { text/javascript mjs; }

        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback (react-router).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
